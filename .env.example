# Public Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only Supabase credential. Never expose this to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Resend sending, receiving and webhook verification
RESEND_API_KEY=re_...
RESEND_WEBHOOK_SECRET=whsec_...

# Email aliases will use this subdomain
FORWARDING_DOMAIN=mail.batforum.online

# Public website URL. A dedicated host avoids replacing the existing root site.
NEXT_PUBLIC_SITE_URL=https://aliases.batforum.online

# Keep false while this is a private service
NEXT_PUBLIC_ALLOW_SIGNUPS=false
