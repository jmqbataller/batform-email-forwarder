# Public Supabase credentials
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Preferred email alias domain
FORWARDING_DOMAIN=dnd.cspro.space

# The previous domain remains accepted during migration by the mail worker/backend.
# Remove legacy support only after old addresses are no longer needed.

# Public website URL. A dedicated host avoids replacing the existing root site.
NEXT_PUBLIC_SITE_URL=https://aliases.batform.online

# Set false after the owner has registered. Database allowlisting still blocks
# non-owner accounts from creating aliases while this is true.
NEXT_PUBLIC_ALLOW_SIGNUPS=false
